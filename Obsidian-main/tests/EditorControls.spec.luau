return function(CreateEditor, Mock, Modules)
    local Library, Box, Window, Input = CreateEditor()
    local Stat = Box:AddStatRow("stat", { Text = "Balance", Value = "1,200" })
    assert(Stat.ValueLabel.Text == "1,200")
    Stat:SetValue("2,500"):SetText("Total")
    assert(Stat.ValueLabel.Text == "2,500" and Stat.Label.Text == "Total")
    Stat:Destroy()
    local Progress = Box:AddProgressBar("progress", { Text = "Progress", Min = 10, Max = 110, Value = 60 })
    assert(Progress.Fill.Size.X.Scale == 0.5)
    Progress:SetValue(200)
    assert(Progress.Value == 110 and Progress.Fill.Size.X.Scale == 1)
    Progress:SetRange(0, 220)
    assert(Progress.Fill.Size.X.Scale == 0.5)
    assert(not pcall(function() Progress:SetRange(2, 1) end))
    Progress:Destroy()
    local InputCalls = 0
    local Amount = Box:AddInput("amount", { Numeric = true, Min = 100, Max = 20000, Default = "12000",
        ThousandsSeparator = true, Callback = function() InputCalls += 1 end })
    local TextBox
    for _, Child in Amount.Holder:GetChildren() do if Child.ClassName == "TextBox" then TextBox = Child end end
    assert(TextBox.Text == "12,000" and Amount.Value == "12000" and InputCalls == 0)
    Amount:SetValue("99999")
    assert(Amount:GetNumber() == 20000 and TextBox.Text == "20,000" and InputCalls == 1)
    Amount:SetValue("invalid")
    assert(Amount:GetNumber() == 20000 and InputCalls == 1)
    TextBox.HasFocus = true
    TextBox.Focused:Fire()
    assert(TextBox.Text == "20000")
    TextBox.Text = "1"
    TextBox:GetPropertyChangedSignal("Text"):Fire()
    assert(Amount.Value == "20000", "Bounded input clamps while the user is still typing")
    TextBox.Text = "1,200"
    TextBox.HasFocus = false
    TextBox.FocusLost:Fire(false)
    assert(Amount.Value == "1200" and TextBox.Text == "1,200")
    Amount:Destroy()
    print("PASS numeric bounds, formatting, focus commit and unchanged input callbacks")
    local Changes = {}
    local Disconnect = Library:OnConfigChanged(function(Event) table.insert(Changes, Event) end)
    local First = Library:AddHidden("batch-a", 1, { ConfigVersion = 2, Save = false })
    local Second = Library:AddHidden("batch-b", 2)
    First.Callback = function() Library:QueueDependencyUpdate() end
    Second.Callback = First.Callback
    local DeferredBefore = #Mock.Deferred
    assert(First.ConfigDefault.Value == 1 and First.ConfigVersion == 2 and not First.Save)
    assert(Library:SetValues({ ["batch-a"] = 10, ["batch-b"] = 20 }))
    assert(#Changes == 1 and Changes[1].Source == "Batch" and Changes[1].Values["batch-a"] == 10)
    assert(#Mock.Deferred == DeferredBefore + 1)
    Mock.Deferred[#Mock.Deferred]()
    assert(Library.DependencyPasses == 1)
    assert(not Library:SetValues({ missing = 10, ["batch-a"] = 99 }))
    assert(First.Value == 10)
    Disconnect()
    Second:SetValue(30)
    assert(#Changes == 1)
    First:Destroy()
    Second:Destroy()
    local Builds = 0
    local Lazy = Window:AddLazyTab("later", { Build = function() Builds += 1 end })
    assert(Builds == 0)
    Lazy:Show()
    Lazy:Show()
    assert(Builds == 1 and Lazy.Built)
    Window:AddLazyTab("config-tab", { Build = function() Builds += 1 end })
    assert(Library:BuildLazyTabs() and Builds == 2)
    Library:RegisterImageGrid(Modules.ImageGallery)
    local Empty = Box:AddImageGrid("empty-grid", { Items = {} })
    local Card = Empty.Slots[1].Button
    Empty:SetItems({ { Id = "late", Image = "123" } })
    assert(Empty.Slots[1].Button == Card and Empty.Slots[1].Item.Id == "late" and Card.Visible)
    Empty:SetItems(Empty.Items)
    assert(#Empty.Items == 1 and Empty.Slots[1].Button == Card)
    Empty:Destroy()
    local Gallery = Box:AddImageGrid("grid", { Items = { { Id = "one", Image = "123" } }, DraggableItems = true })
    assert(Gallery:Select("one") and Gallery:GetSelected().Id == "one")
    Library.Options.grid:Destroy()
    assert(Gallery.Destroyed and Library.Options.grid == nil)
    local Calls = 0
    local Slots = Box:AddItemSlots("stickers", {
        Slots = { "A", "B" },
        Accept = function(Item) return Item.Id ~= "blocked" end,
        Callback = function() Calls += 1 end,
    })
    assert(Slots:Assign("A", { Id = "blue", Name = "Blue" }))
    assert(Slots.Value.A == "blue")
    assert(not Slots:Assign("A", { Id = "blocked" }))
    assert(Slots.Value.A == "blue")
    Slots:SetDisabled(true)
    assert(not Slots:Assign("B", { Id = "red" }))
    Slots:SetDisabled(false)
    Slots:SetValue({ B = "saved" })
    assert(Slots.Value.A == nil and Slots.Value.B == "saved")
    local Valid = pcall(function() Slots:SetValue({ Unknown = "x" }) end)
    assert(not Valid and Slots.Value.B == "saved")
    Slots:SetVisible(false)
    assert(not Slots.Holder.Visible)
    Slots:Destroy()
    assert(Library.Options.stickers == nil and #Library.ItemDropTargets == 0)
    Slots:Destroy()

    Slots = Box:AddItemSlots("drag-slots", { Slots = { "A" }, DragType = "Sticker" })
    local Scroller = Mock.Instance.new("ScrollingFrame")
    Scroller.Parent = Library.ScreenGui
    Scroller.ScrollingEnabled = true
    local Source = Mock.Instance.new("TextButton")
    Source.Parent = Scroller
    Source.AbsoluteSize = Mock.Vector2.new(80, 80)
    Slots.Cells.A.Button.AbsolutePosition = Mock.Vector2.new(100, 0)
    Slots.Cells.A.Button.AbsoluteSize = Mock.Vector2.new(80, 80)
    local Binding = Library:BindItemDragSource(Source, function() return { Id = "dragged" } end, "Sticker")
    local Pointer = { UserInputType = Mock.Enum.UserInputType.MouseButton1, Position = Mock.Vector2.new(10, 10) }
    Source.InputBegan:Fire(Pointer)
    Input.InputChanged:Fire({ UserInputType = Mock.Enum.UserInputType.MouseMovement, Position = Mock.Vector2.new(120, 10) })
    assert(not Scroller.ScrollingEnabled)
    Input.InputEnded:Fire(Pointer)
    assert(Slots.Value.A == "dragged" and Scroller.ScrollingEnabled)
    assert(Library.CancelItemDrag == nil and Binding.SuppressClick)
    Slots:Assign("A", nil)
    Slots:SetVisible(false)
    Source.InputBegan:Fire(Pointer)
    Input.InputChanged:Fire({ UserInputType = Mock.Enum.UserInputType.MouseMovement, Position = Mock.Vector2.new(120, 10) })
    Input.InputEnded:Fire(Pointer)
    assert(Slots.Value.A == nil)
    Source.InputBegan:Fire(Pointer)
    Input.InputChanged:Fire({ UserInputType = Mock.Enum.UserInputType.MouseMovement, Position = Mock.Vector2.new(120, 10) })
    Input.WindowFocusReleased:Fire()
    assert(Library.CancelItemDrag == nil and Scroller.ScrollingEnabled)
    Binding:Disconnect()
    Slots:Destroy()

    local Changes = 0
    local Group = Box:AddSliderGroup("transform", { Callback = function() Changes += 1 end })
    assert(Group:GetValue().Scale == 1)
    Group:SetValue({ X = 0.5, Rotation = 90 })
    assert(Changes == 1 and Group:GetValue().X == 0.5 and Group:GetValue().Rotation == 90)
    assert(Library.Options["transform/X"] == Group.Sliders.X)
    Group.Holder.AbsoluteSize = Mock.Vector2.new(210, 100)
    Group.Holder:GetPropertyChangedSignal("AbsoluteSize"):Fire()
    for _, Cell in Group.Cells do
        assert(Cell.Position.X.Offset + Cell.Size.X.Offset <= 210)
    end
    local Before = Group:GetValue()
    assert(not pcall(function() Group:SetValue({ X = 0, Missing = 1 }) end))
    assert(Group:GetValue().X == Before.X)
    Group:Destroy()
    assert(Library.Options["transform/X"] == nil)

    local Parent = Window:AddPopup("catalog", { Title = "Catalog", Width = 500 })
    local Child = Parent:AddPopup("editor", { Title = "Editor" })
    assert(Library.ActiveDialog == Child and #Library.DialogStack == 2)
    assert(Child.Overlay.ZIndex > Parent.Overlay.ZIndex)
    Child:Dismiss()
    assert(Library.ActiveDialog == Parent and not Parent.Destroyed)
    Child = Parent:AddPopup("editor", {})
    local Grandchild = Child:AddPopup("detail", {})
    Parent:Dismiss()
    assert(Child.Destroyed and Grandchild.Destroyed and #Library.DialogStack == 0 and Library.ActiveDialog == nil)
    Parent = Window:AddPopup("catalog", {})
    Child = Parent:AddPopup("editor", {})
    Input.InputBegan:Fire({ KeyCode = Mock.Enum.KeyCode.Escape }, false)
    assert(Child.Destroyed and not Parent.Destroyed and Library.ActiveDialog == Parent)
    Parent:Dismiss()
    print("PASS item drops, hidden target rejection, cancellation, grouped sliders and popup stack lifecycle")
end
